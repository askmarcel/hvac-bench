{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askmarcel.app/hvac-bench/schema-v3.json",
  "title": "HVAC Bench v3 — cas diagnostic quantitatif",
  "description": "Observations structurées ; polarité et candidats dérivés par le moteur v3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "split", "locale",
    "symptom", "context", "observations",
    "expert_path", "ground_truth", "harvest", "flags", "meta"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^hb[23]-([0-9]{4}|neon-[0-9]{4})$" },
    "version": { "const": 3 },
    "split": { "enum": ["public", "heldout"] },
    "locale": { "enum": ["fr", "en"] },
    "symptom": {
      "type": "object",
      "required": ["narrative", "code_present", "code_absent_by_design"],
      "properties": {
        "narrative": { "type": "string", "minLength": 60 },
        "code_present": { "type": ["string", "null"] },
        "code_absent_by_design": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "required": ["brand", "equipment_type", "in_corpus"],
      "properties": {
        "brand": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "equipment_type": { "const": "pac_air_eau" },
        "install_age_years": { "type": ["number", "null"] },
        "season": { "enum": ["hiver", "ete", "mi_saison", null] },
        "emitter": { "type": ["string", "null"] },
        "regime_eau": { "enum": ["chauffage", "ecs", "mixte", null] },
        "puissance_kw": { "type": ["number", "null"] },
        "fluide": { "type": ["string", "null"] },
        "target_component": { "enum": ["circulateur", "compresseur", null] },
        "in_corpus": { "type": "boolean" }
      }
    },
    "initial_readings": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "object", "required": ["quantity_id", "value"], "properties": { "quantity_id": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" } } },
          { "type": "object", "required": ["quantity_id", "modality"], "properties": { "quantity_id": { "type": "string" }, "modality": { "type": "string" } } }
        ]
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "reading"],
        "properties": {
          "action_id": { "type": "string" },
          "reading": {
            "oneOf": [
              {
                "type": "object",
                "required": ["quantity_id", "value"],
                "properties": {
                  "quantity_id": { "type": "string" },
                  "value": { "type": "number" },
                  "unit": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["quantity_id", "modality"],
                "properties": {
                  "quantity_id": { "type": "string" },
                  "modality": { "type": "string" }
                }
              }
            ]
          },
          "resolves": { "type": "boolean" },
          "wrong_part": { "type": "boolean" },
          "observation_text": { "type": "string", "description": "Trace reformulée REQ-A3" }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "required": ["cause_id"],
      "properties": {
        "cause_id": { "type": "string" }
      }
    },
    "expert_path": { "type": "array", "items": { "type": "string" } },
    "expert_path_cost_eur": { "type": "number" },
    "expert_path_minutes": { "type": "number" },
    "forbidden_before": { "type": "object" },
    "escalation_expected": { "type": ["object", "null"] },
    "harvest": {
      "type": "object",
      "required": ["reformulated"],
      "properties": {
        "source_type": { "enum": ["neon_forum", "pilot_rewrite", "manual"] },
        "neon_id": { "type": "string" },
        "source_url": { "type": "string" },
        "source_forum": { "type": "string" },
        "harvest_date": { "type": "string" },
        "reformulated": { "const": true }
      }
    },
    "flags": {
      "type": "object",
      "properties": {
        "gate_critical": { "type": "boolean" },
        "safety_sensitive": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string" },
        "author": { "type": "string" },
        "family": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
